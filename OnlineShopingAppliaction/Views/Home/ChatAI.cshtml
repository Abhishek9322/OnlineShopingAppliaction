@{
    ViewData["Title"] = "AI Shopping Assistant";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background-color: #f5f6fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .chat-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 30px 0;
        min-height: calc(100vh - 70px);
    }

    .chat-container {
        width: 90%;
        height: 80vh;
        border: 2px solid #ced4da;
        border-radius: 20px;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .chat-header {
        background-color: #e9ecef;
        color: #333;
        padding: 15px 25px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        font-size: 1.3rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #d0d0d0;
    }

    .chat-body {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        scroll-behavior: smooth;
    }

    .chat-message {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 18px;
        line-height: 1.6;
        font-size: 0.95rem;
        white-space: pre-wrap;
    }

    .user-message {
        align-self: flex-end;
        background-color: #dcf8c6;
        border-bottom-right-radius: 5px;
    }

    .ai-message {
        align-self: flex-start;
        background-color: #f1f0f0;
        border-bottom-left-radius: 5px;
    }

    .error-message {
        align-self: center;
        background-color: #ffe6e6;
        color: red;
    }

    .chat-footer {
        display: flex;
        padding: 15px;
        border-top: 1px solid #ddd;
        background-color: #f8f9fa;
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
    }

    #userInput {
        flex: 1;
        border-radius: 50px;
        border: 1px solid #ccc;
        padding: 10px 20px;
        outline: none;
        font-size: 1rem;
    }

    #sendBtn {
        margin-left: 10px;
        border-radius: 50px;
        padding: 10px 25px;
        font-size: 1rem;
        background-color: #6c757d;
        border: none;
        color: white;
        transition: 0.3s ease;
    }

        #sendBtn:hover {
            background-color: #5a6268;
        }

    /* Scrollbar */
    .chat-body::-webkit-scrollbar {
        width: 8px;
    }

    .chat-body::-webkit-scrollbar-thumb {
        background-color: #bdbdbd;
        border-radius: 10px;
    }

    /* AI message formatting */
    .ai-message ul {
        padding-left: 20px;
        margin: 5px 0;
    }

    .ai-message strong {
        color: #007bff;
    }

    /* Thinking loader animation */
    .thinking-indicator {
        align-self: flex-start;
        display: flex;
        align-items: center;
        gap: 8px;
        color: #555;
        background-color: #f1f0f0;
        padding: 10px 14px;
        border-radius: 15px;
        font-style: italic;
        animation: fadeIn 0.3s ease-in-out;
    }

        .thinking-indicator .dot {
            width: 6px;
            height: 6px;
            background-color: #555;
            border-radius: 50%;
            animation: blink 1.2s infinite ease-in-out;
        }

            .thinking-indicator .dot:nth-child(2) {
                animation-delay: 0.2s;
            }

            .thinking-indicator .dot:nth-child(3) {
                animation-delay: 0.4s;
            }

  
   
</style>

<div class="chat-wrapper">
    <div class="chat-container">
        <div class="chat-header">
            🛍️ AI Shopping Assistant
        </div>

        <div class="chat-body" id="chatMessages"></div>

        <div class="chat-footer">
            <input type="text" id="userInput" class="form-control" placeholder="Ask Shpping Related ... " />
            <button class="btn" id="sendBtn">Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chatMessages = document.getElementById("chatMessages");
        const userInput = document.getElementById("userInput");
        const sendBtn = document.getElementById("sendBtn");
        let conversationHistory = '';
        let thinkingDiv = null; // store the loader div

        async function sendMessage() {
            const message = userInput.value.trim();
            if (!message) return;

            appendMessage(message, "user");
            userInput.value = "";

            // Show thinking indicator
            showThinkingIndicator();

            const allowedTopics = ["phone", "laptop", "watch", "clothes", "shoe", "camera", "shopping", "bag", "headphone", "tv", "gadget"];
            const isShoppingRelated = allowedTopics.some(word => message.toLowerCase().includes(word));
            if (!isShoppingRelated) {
                removeThinkingIndicator();
                appendMessage("🛒 I can only help with shopping-related queries like phones, clothes, or gadgets!", "ai");
                return;
            }

            const url = '@Url.Action("SendMessage", "Home")';

            try {
                const response = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `message=${encodeURIComponent(message)}&history=${encodeURIComponent(conversationHistory)}`
                });

                const data = await response.json();
                removeThinkingIndicator(); // remove loader before showing reply

                if (data.error) {
                    appendMessage(data.error, "error");
                } else {
                    const formattedResponse = formatResponse(data.response);
                    appendMessage(formattedResponse, "ai", true);
                    conversationHistory += `You: ${message}\nAI: ${data.response}\n`;
                }
            } catch (err) {
                removeThinkingIndicator();
                appendMessage("⚠️ Network or server error occurred.", "error");
                console.error(err);
            }
        }

        function appendMessage(text, type, isHTML = false) {
            const msgDiv = document.createElement("div");
            msgDiv.classList.add("chat-message");

            if (type === "user") msgDiv.classList.add("user-message");
            else if (type === "ai") msgDiv.classList.add("ai-message");
            else msgDiv.classList.add("error-message");

            if (isHTML) msgDiv.innerHTML = text;
            else msgDiv.textContent = text;

            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function formatResponse(text) {
            let html = text
                .replace(/\n\n/g, "</p><p>")
                .replace(/\n/g, "<br>")
                .replace(/\*\s/g, "• ")
                .replace(/(^|\n)([A-Z][a-z]+:)/g, "<strong>$2</strong>");
            return `<p>${html}</p>`;
        }

        function showThinkingIndicator() {
            if (thinkingDiv) return;
            thinkingDiv = document.createElement("div");
            thinkingDiv.classList.add("thinking-indicator");
            thinkingDiv.innerHTML = `
                AI is thinking
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            `;
            chatMessages.appendChild(thinkingDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function removeThinkingIndicator() {
            if (thinkingDiv) {
                thinkingDiv.remove();
                thinkingDiv = null;
            }
        }

        sendBtn.addEventListener("click", sendMessage);
        userInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") sendMessage();
        });
    </script>
}
